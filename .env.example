# Copy to .env.local (development) or set in your hosting provider. Never commit real values.

# Where the Next.js server reaches the API (private network address in production).
API_INTERNAL_URL=http://localhost:4000
# Same value as the API's INTERNAL_API_KEY (32+ random characters).
INTERNAL_API_KEY=
# Same value as the API's REVALIDATE_SECRET; the API calls /api/revalidate with it after publishing.
REVALIDATE_SECRET=

# Public, canonical site URL (https in production). Used for canonical URLs, sitemaps and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app config (Firebase console > Project settings > Your apps). These are public identifiers.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local development only: Firebase Auth emulator.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Google AdSense publisher id (ca-pub-…). Leave empty: no ads, no ads.txt, no consent banner.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Publish /news-sitemap.xml only after confirming Google News eligibility.
NEWS_SITEMAP_ENABLED=false
# Show labelled sample ad boxes in every placement (layout review only).
NEXT_PUBLIC_DEMO_ADS=false
